TELEGRAM_BOT_TOKEN=replace-with-botfather-token
ALLOWED_USER_IDS=
# Full admins (all admin commands): one numeric ID or several, comma-separated, e.g. 111,222
ADMIN_TELEGRAM_ID=123456789
# Optional: who may approve access requests only (no admin commands). Defaults to ALLOWED_USER_IDS; ADMIN_TELEGRAM_ID users always can.
ADMIN_USER_IDS=
POSTGRES_PASSWORD=replace-with-long-random-password
MINIO_ROOT_USER=voicebot
MINIO_ROOT_PASSWORD=replace-with-another-long-random-password
S3_BUCKET=voice-samples
